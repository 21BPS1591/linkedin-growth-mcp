GEMINI_API_KEY=
# Defaults shown; verify current model ids in Google's docs
GEMINI_TEXT_MODEL=gemini-2.5-flash
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=http://localhost:8765/callback
LINKEDIN_API_VERSION=202610
# Required for HTTP transport: generate with `python -c "import secrets;print(secrets.token_urlsafe(32))"`
MCP_AUTH_TOKEN=
MAX_POSTS_PER_WEEK=7
DAILY_GEMINI_CALL_CAP=16
DAILY_BROWSER_PAGE_CAP=150
EXTRACTION_PASSES=1
# GEMINI_DRAFT_MODEL=   (optional: a cheaper model just for drafting)
ATTACH_IMAGES=false
POST_HOUR=9
# Series hashtag appended to every post
BRAND_HASHTAG=#IPOByTheNumbers
# Broad-reach tags added after the series tag (max 5 hashtags per post in total)
REACH_HASHTAGS=#IPO #StockMarket #IndianStockMarket #Finance
# Hourly chittorgarh.com IPO data sync (no Gemini calls)
MARKET_SYNC=true
# Desktop alert when a post is missed or the autopilot hits an error
ALERTS=true

# One Gemini key per job. A job without its own key is paused; the content key is never used for it.
# GEMINI_API_KEY (above) = post and content generation only.
GEMINI_ACCOUNT=
GEMINI_IMAGE_API_KEY=
GEMINI_IMAGE_ACCOUNT=
GEMINI_EXTRACTION_API_KEY=
GEMINI_EXTRACTION_ACCOUNT=
GEMINI_INSIGHTS_API_KEY=
GEMINI_INSIGHTS_ACCOUNT=
DAILY_IMAGE_CALL_CAP=4
DAILY_EXTRACTION_CALL_CAP=10
DAILY_INSIGHTS_CALL_CAP=8
